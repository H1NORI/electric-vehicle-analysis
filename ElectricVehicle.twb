      <column caption='SUM( IF [Electric Vehicle Type] = &quot;Plug-in Hybrid Electric Ve...' datatype='integer' name='[Calculation_2764682782187520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;&#10;IF [Electric Vehicle Type] = &quot;Plug-in Hybrid Electric Vehicle (PHEV)&quot;&#10;&#10;THEN 1&#10;&#10;ELSE 0&#10;&#10;END&#10;&#10;)' />
      </column>
      <column caption='SUM( IF [Electric Vehicle Type] = &quot;Battery Electric Vehicle (...' datatype='integer' name='[Calculation_2764682782334977]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;&#10;IF [Electric Vehicle Type] = &quot;Battery Electric Vehicle (BEV)&quot;&#10;&#10;THEN 1&#10;&#10;ELSE 0&#10;&#10;END&#10;&#10;)' />
      </column>
      <column caption='IF SUM( IF [Electric Vehicle Type]=&quot;Plug-in Hybrid Electric V...' datatype='string' name='[Calculation_2764682782527490]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF&#10;SUM(&#10;IF [Electric Vehicle Type]=&quot;Plug-in Hybrid Electric Vehicle (PHEV)&quot;&#10;THEN 1 ELSE 0 END&#10;)&#10;&gt;&#10;SUM(&#10;IF [Electric Vehicle Type]=&quot;Battery Electric Vehicle (BEV)&quot;&#10;THEN 1 ELSE 0 END&#10;)&#10;&#10;THEN &quot;PHEV&quot;&#10;&#10;ELSE &quot;BEV&quot;&#10;&#10;END' />
      </column>
      <column caption='COUNT(PHEV)' datatype='integer' name='[Calculation_2764682785591301]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;IF [Electric Vehicle Type] = &quot;Plug-in Hybrid Electric Vehicle (PHEV)&quot;&#10;THEN 1&#10;ELSE 0&#10;END&#10;)' />
      </column>
      <column caption='COUNT(BEV)' datatype='integer' name='[Calculation_2764682785882118]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;IF [Electric Vehicle Type] = &quot;Battery Electric Vehicle (BEV)&quot;&#10;THEN 1&#10;ELSE 0&#10;END&#10;)' />
      </column>
      <column caption='COMPARE PHEV and BEV' datatype='string' name='[Calculation_2764682786148360]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF&#10;SUM(&#10;IF [Electric Vehicle Type]=&quot;Plug-in Hybrid Electric Vehicle (PHEV)&quot;&#10;THEN 1 ELSE 0 END&#10;)&#10;&gt;&#10;SUM(&#10;IF [Electric Vehicle Type]=&quot;Battery Electric Vehicle (BEV)&quot;&#10;THEN 1 ELSE 0 END&#10;)&#10;&#10;THEN &quot;PHEV&quot;&#10;&#10;ELSE &quot;BEV&quot;&#10;&#10;END' />
